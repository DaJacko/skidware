        end
        local t = Label({ Text = name, TextTransparency = 0.5, Size = UDim2.fromOffset(150, 16),
            LayoutOrder = nextOrder(), Parent = tabList })
        New("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = t })
    end

    function Window:AddTab(name, icon)
        local Tab = { Subtabs = {}, Current = nil }
        local btn = New("TextButton", { Size = UDim2.fromOffset(150, 30), BackgroundColor3 = Theme.FrameActive,
            BackgroundTransparency = 1, AutoButtonColor = false, Text = "", LayoutOrder = nextOrder(), Parent = tabList }, { Corner(5) })
