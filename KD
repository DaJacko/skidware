    local subHolder = New("Frame", { Size = UDim2.fromOffset(240, 25), Position = UDim2.fromOffset(300, 20), BackgroundTransparency = 1, Parent = main })
    local pageHolder = New("Frame", { Size = UDim2.fromOffset(490, 404), Position = UDim2.fromOffset(185, 81),
        BackgroundTransparency = 1, ClipsDescendants = true, Parent = main })
    local fade = New("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = pageHolder })
    local function animatePage()
        fade.GroupTransparency = 1
        pageHolder.Position = UDim2.fromOffset(185, 81)
        Tween(fade, 0.35, { GroupTransparency = 0 })
        Tween(pageHolder, 0.35, { Position = UDim2.fromOffset(185, 76) })
    end
    Window.Animate = animatePage

    do
        local dragging, dragStart, startPos
        local dragArea = New("Frame", { Size = UDim2.fromOffset(170, 60), BackgroundTransparency = 1, Parent = main })
        local function begin(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging, dragStart, startPos = true, input.Position, main.Position
                input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
            end
        end
        dragArea.InputBegan:Connect(begin)
        topbar.InputBegan:Connect(begin)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
    end

    -- === MENU OPEN/CLOSE + CURSOR UNLOCK ===
    local menuOpen = false
    local savedMouseBehavior, savedMouseIconEnabled

    local function setMenuOpen(open)
        if menuOpen == open then return end
        menuOpen = open
        main.Visible = open
        if open then
            if savedMouseBehavior == nil then
                savedMouseBehavior = UserInputService.MouseBehavior
                savedMouseIconEnabled = UserInputService.MouseIconEnabled
            end
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        else
            if savedMouseBehavior ~= nil then
                UserInputService.MouseBehavior = savedMouseBehavior
                UserInputService.MouseIconEnabled = savedMouseIconEnabled
                savedMouseBehavior = nil
                savedMouseIconEnabled = nil
            end
        end
        if Window.Blur and Window.Blur.Parent then
            Tween(Window.Blur, 0.3, { Size = open and (cfg.Blur or 12) or 0 })
        end
    end
    Window.SetMenuOpen = setMenuOpen
    Window.IsMenuOpen = function() return menuOpen end

    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == Library.ToggleKey then
            setMenuOpen(not menuOpen)
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not main or not main.Parent then return end
        if menuOpen then
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end
            if not UserInputService.MouseIconEnabled then
                UserInputService.MouseIconEnabled = true
            end
        end
    end)

    task.spawn(function()
        while main and main.Parent do
            task.wait(0.5)
            local targetSize = menuOpen and (cfg.Blur or 12) or 0
            if not Window.Blur or not Window.Blur.Parent then
                Window.Blur = New("BlurEffect", { Name = "NeverloseBlur", Size = targetSize, Parent = Lighting })
            elseif math.abs(Window.Blur.Size - targetSize) > 2 then
                Window.Blur.Size = targetSize
            end
        end
    end)

