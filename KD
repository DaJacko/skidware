-- ===== VIEWMODEL CHAMS =====
local vmTrueOriginals = setmetatable({}, {__mode = "k"})
local vmPropertyConns = setmetatable({}, {__mode = "k"})
local vmKnifeCache    = setmetatable({}, {__mode = "k"})
local vmTrackedParts, vmTrackedSet = {}, {}
local _applying = setmetatable({}, {__mode = "k"})
local KNIFE_NAMES = { Knife = true, LeftKnife = true, EquippedKnife = true, ViewmodelKnifeVisual = true }
local function isKnifePartCached(part)
    local cached = vmKnifeCache[part]; if cached ~= nil then return cached end
    local current, depth, result = part.Parent, 0, false
    while current and depth < 8 do
        if KNIFE_NAMES[current.Name] then result = true; break end
        current = current.Parent; depth += 1
    end
    vmKnifeCache[part] = result; return result
end
local function isFirstPersonCamera()
    local cam = Workspace.CurrentCamera; if not cam then return false end
    return (cam.CFrame.Position - cam.Focus.Position).Magnitude < 2
end
local function captureOriginal(part)
    if not vmTrueOriginals[part] then vmTrueOriginals[part] = { material = part.Material, color = part.Color } end
end
local function applyToPart(part)
    if _applying[part] then return end
    _applying[part] = true
    local orig = vmTrueOriginals[part]
    pcall(function()
        if Settings.viewmodelChamsEnabled then
            if part.Material ~= Enum.Material.ForceField then part.Material = Enum.Material.ForceField end
            local col = tableToColor(Settings.viewmodelChamsColor); if part.Color ~= col then part.Color = col end
        elseif orig then
            if part.Material ~= orig.material then part.Material = orig.material end
            if part.Color ~= orig.color then part.Color = orig.color end
        end
        local targetT = (Settings.viewmodelTransparency > 0) and Settings.viewmodelTransparency or 0
        if part.LocalTransparencyModifier ~= targetT then part.LocalTransparencyModifier = targetT end
    end)
    _applying[part] = nil
end
local function restorePart(part)
    local orig = vmTrueOriginals[part]
    if orig and part.Parent then pcall(function() part.Material = orig.material; part.Color = orig.color; part.LocalTransparencyModifier = 0 end) end
end
local function hookPart(part)
    local conns = vmPropertyConns[part]; if not conns then conns = {}; vmPropertyConns[part] = conns end
    local handler = function()
        if _unloaded or _applying[part] then return end
        if not Settings.viewmodelChamsEnabled and Settings.viewmodelTransparency <= 0 then return end
        if not Settings.viewmodelIncludeKnife and isKnifePartCached(part) then return end
        applyToPart(part)
    end
    if not conns.material then conns.material = part:GetPropertyChangedSignal("Material"):Connect(handler) end
    if not conns.color then conns.color = part:GetPropertyChangedSignal("Color"):Connect(handler) end
    if Settings.viewmodelTransparency > 0 and not conns.transparency then conns.transparency = part:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(handler) end
end
local function unhookPart(part)
    local conns = vmPropertyConns[part]
    if conns then for _, c in pairs(conns) do pcall(function() c:Disconnect() end) end; vmPropertyConns[part] = nil end
end
local function addKnifeInstance(inst, addFn)
    if not inst then return end
    if inst:IsA("Model") then for _, d in ipairs(inst:GetDescendants()) do addFn(d) end
    elseif inst:IsA("BasePart") then addFn(inst)
    elseif inst:IsA("ObjectValue") then
        local val = inst.Value
        if val then
            if val:IsA("BasePart") then addFn(val) end
            if val:IsA("Model") or val:IsA("Folder") then for _, d in ipairs(val:GetDescendants()) do addFn(d) end end
        end
    end
end
local function findViewmodelParts()
    local parts, seen = {}, {}
    local cam = Workspace.CurrentCamera; if not cam then return parts end
    local includeKnife = Settings.viewmodelIncludeKnife
    local function add(p)
        if p and p:IsA("BasePart") and not seen[p] then
            if not includeKnife and isKnifePartCached(p) then return end
            seen[p] = true; parts[#parts + 1] = p
        end
    end
    if ViewmodelControllerRef then
        local vm = ViewmodelControllerRef.Model or ViewmodelControllerRef.ViewModel or ViewmodelControllerRef.CurrentViewmodel or ViewmodelControllerRef.Viewmodel or ViewmodelControllerRef.currentModel or ViewmodelControllerRef.activeViewmodel or ViewmodelControllerRef.ViewModelInstance or ViewmodelControllerRef._viewmodel or ViewmodelControllerRef.viewmodel
        if vm and vm:IsA("Model") then for _, d in ipairs(vm:GetDescendants()) do add(d) end end
    end
    for _, child in ipairs(cam:GetChildren()) do
        if child:IsA("Model") then for _, d in ipairs(child:GetDescendants()) do add(d) end
        elseif child:IsA("BasePart") then add(child) end
    end
    if includeKnife and isFirstPersonCamera() then
        local char = LocalPlayer.Character
        if char then addKnifeInstance(char:FindFirstChild("EquippedKnife"), add); addKnifeInstance(char:FindFirstChild("LeftKnife"), add) end
    end
    return parts
end
local function updateViewmodel()
    if not Settings.viewmodelChamsEnabled and Settings.viewmodelTransparency <= 0 then
        for _, part in ipairs(vmTrackedParts) do restorePart(part); unhookPart(part) end
        table.clear(vmTrackedParts); table.clear(vmTrackedSet); return
    end
    local currentParts = findViewmodelParts(); local currentSet = {}
    for _, p in ipairs(currentParts) do currentSet[p] = true end
    for _, part in ipairs(vmTrackedParts) do if not currentSet[part] then restorePart(part); unhookPart(part) end end
    table.clear(vmTrackedParts); table.clear(vmTrackedSet)
    for _, part in ipairs(currentParts) do vmTrackedParts[#vmTrackedParts + 1] = part; vmTrackedSet[part] = true end
    for _, part in ipairs(currentParts) do captureOriginal(part); hookPart(part); applyToPart(part) end
end
local lastVmUpdate = 0
RunService.Heartbeat:Connect(function()
    if _unloaded then return end
    local now = os.clock(); if now - lastVmUpdate < 1 / VM_UPDATE_HZ then return end
    lastVmUpdate = now; updateViewmodel()
end)

-- ===== CHAMS =====
local chamsCache = setmetatable({}, {__mode = "k"})
local visCache, visTimestamps = setmetatable({}, {__mode = "k"}), setmetatable({}, {__mode = "k"})
local function isVisibleCached(character, camPos)
    local now = os.clock(); local ts = visTimestamps[character]
    if visCache[character] ~= nil and ts and (now - ts < VIS_CACHE_TTL) then return visCache[character] end
    local vis = isCharVisibleMulti(character, camPos); visCache[character] = vis; visTimestamps[character] = now; return vis
end
local function destroyCham(character)
    local c = chamsCache[character]; if c and c.highlight then pcall(function() c.highlight:Destroy() end) end
    chamsCache[character] = nil
end
local function updateChamForCharacter(character, camPos)
    local c = chamsCache[character]
    if not c or not c.highlight or c.highlight.Parent ~= character then
        destroyCham(character)
        local h = Instance.new("Highlight")
        h.Name = "TriggerbotCham"; h.Archivable = false; h.Adornee = character
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; h.OutlineTransparency = 0; h.Parent = character
        chamsCache[character] = { highlight = h }; c = chamsCache[character]
    end
    local h = c.highlight
    local player = Players:GetPlayerFromCharacter(character)
    local isTeam = player and isTeammate(player)
    local head = character:FindFirstChild("Head") or getReferencePart(character)
    local visible = head and isVisibleCached(character, camPos) or false
    h.Enabled = true; h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; h.FillTransparency = Settings.chamsFillAlpha
    if isTeam then h.FillColor = tableToColor(Settings.chamsTeamFill); h.OutlineColor = tableToColor(Settings.chamsTeamColor)
    elseif visible then h.FillColor = tableToColor(Settings.chamsVisibleFill); h.OutlineColor = tableToColor(Settings.chamsVisibleColor)
    else h.FillColor = tableToColor(Settings.chamsNormalFill); h.OutlineColor = tableToColor(Settings.chamsNormalColor) end
end
local lastChams = 0
RunService.Heartbeat:Connect(function()
    if _unloaded then return end
    local now = os.clock(); if now - lastChams < 1 / CHAMS_UPDATE_HZ then return end
    lastChams = now
    if not Settings.chamsEnabled then for character in pairs(chamsCache) do destroyCham(character) end; unhookAllGameHighlights(); return end
    local camera = Workspace.CurrentCamera; if not camera then return end
    local camPos = camera.CFrame.Position; local seenCham = {}
    for _, char in ipairs(getAllTargetChars()) do
        local ok = isCharacterAliveCached(char)
        local refPart = getReferencePart(char)
        if ok and refPart then if (refPart.Position - camPos).Magnitude > Settings.chamsMaxDistance then ok = false end else ok = false end
        if ok then
            if Settings.chamsOverrideGameHighlights then hookGameHighlights(char) end
            seenCham[char] = true; updateChamForCharacter(char, camPos)
        else destroyCham(char) end
    end
    for character in pairs(chamsCache) do if not seenCham[character] then destroyCham(character) end end
end)

