-- ACCURACY PATCH: forward-only LOS. The old reverse ray cast from *inside* the target
-- and hit geometry the forward pass legitimately skipped (glass/hitboxes/accessories),
-- producing false negatives. Forward ray alone is now the single source of truth.
local function hasClearLine(camPos, targetPos, targetChar)
    local delta = targetPos - camPos
    local dist  = delta.Magnitude
    if dist < 0.1 then return true end
    local dir = delta / dist
    local ignoreList = {}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    if targetChar then table.insert(ignoreList, targetChar) end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    params.RespectCanCollide = false
    local current, remaining = camPos, dist
    for _ = 1, 24 do
        if remaining < 0.1 then return true end
        params.FilterDescendantsInstances = ignoreList
        local hit = Workspace:Raycast(current, dir * remaining, params)
        if not hit then return true end
        local inst = hit.Instance
        local skip = false
        if inst:IsA("BasePart") then
            if inst.Transparency >= 0.9 then skip = true
            elseif Settings.losIgnoreGlass and (inst.Material == Enum.Material.Glass
                or inst.Material == Enum.Material.ForceField) then skip = true end
        end
        if not skip and isHitboxPart(inst) then skip = true end
        if not skip then
            local p = inst.Parent
            while p and p ~= Workspace do
                if p:IsA("Accessory") or p:IsA("Tool") or isRagdollProxyAncestor(p) then
                    skip = true; break
                end
                p = p.Parent
            end
        end
        if skip then
            table.insert(ignoreList, inst)
            local advance = hit.Distance + 0.1
            current   = current + dir * advance
            remaining = remaining - advance
        else
            return false
        end
    end
    return remaining < 1
end
local function isCharVisibleAny(character, camPos)
    local head = character:FindFirstChild("Head"); if head and hasClearLine(camPos, head.Position, character) then return true end
    local ut = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if ut and hasClearLine(camPos, ut.Position, character) then return true end
    local lt = character:FindFirstChild("LowerTorso"); if lt and hasClearLine(camPos, lt.Position, character) then return true end
    return false
end
local function isCharVisibleMulti(character, camPos)
    local parts = {}
    local head = character:FindFirstChild("Head"); if head then parts[#parts+1] = head end
    local ut = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"); if ut then parts[#parts+1] = ut end
    local lt = character:FindFirstChild("LowerTorso"); if lt then parts[#parts+1] = lt end
    if #parts == 0 then local ref = character:FindFirstChild("HumanoidRootPart") or getReferencePart(character); return ref and hasClearLine(camPos, ref.Position, character) or false end
    local count = 0
    for _, part in ipairs(parts) do if hasClearLine(camPos, part.Position, character) then count += 1 end end
    return count >= math.ceil(#parts / 2)
end

