function Library:Notify(opts)
    if type(opts) == "string" then opts = { Text = opts } end
    local title    = opts.Title    or "SKIDWARE"
    local text     = opts.Text     or ""
    local duration = opts.Duration or 5
    local accent   = opts.Accent   or Theme.Accent

    if not Library.__notifyHolder or not Library.__notifyHolder.Parent then
        Library.__notifyHolder = New("Frame", {
            Name = "NeverloseNotifications",
            Size = UDim2.new(0, 280, 1, -40),
            Position = UDim2.new(1, -300, 0, 20),
            BackgroundTransparency = 1,
            ZIndex = 100,
            Parent = GetParentGui(),
        })
    end
    local holder = Library.__notifyHolder

    -- measure existing toasts, soft cap at 5
    local count, yPos = 0, 0
    for _, child in ipairs(holder:GetChildren()) do
        if child:IsA("CanvasGroup") then
            count = count + 1
            yPos  = yPos + child.Size.Y.Offset + 6
        end
    end
    if count >= 5 then return end

    local toast = New("CanvasGroup", {
        Name = "Toast",
        Size = UDim2.new(1, 0, 0, 60),
        Position = UDim2.new(1, 30, 0, yPos),
        BackgroundColor3 = Theme.FrameInactive,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        ZIndex = 101,
        Parent = holder,
    }, { Corner(4), Stroke() })

    New("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = accent, BorderSizePixel = 0, ZIndex = 102, Parent = toast,
    }, { Corner(2) })

    Label({ Text = title, Font = Theme.FontBold, TextSize = 13, TextColor3 = accent,
        Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 16), ZIndex = 102, Parent = toast })
    Label({ Text = text, TextSize = 12, TextColor3 = Theme.Text,
        Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -24, 0, 26),
        TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 102, Parent = toast })

    Tween(toast, 0.3, { Position = UDim2.new(0, 0, 0, yPos), GroupTransparency = 0 })

    task.delay(duration, function()
        if not toast.Parent then return end
        local curY = toast.Position.Y.Offset
        local fade = Tween(toast, 0.25, { GroupTransparency = 1, Position = UDim2.new(1, 30, 0, curY) })
        fade.Completed:Connect(function()
            local removedY = toast.Size.Y.Offset + 6
            toast:Destroy()
            for _, child in ipairs(holder:GetChildren()) do
                if child:IsA("CanvasGroup") and child.Position.Y.Offset > curY then
                    Tween(child, 0.2, { Position = UDim2.new(0, 0, 0, child.Position.Y.Offset - removedY) })
                end
            end
        end)
    end)
end

